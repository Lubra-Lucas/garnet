# Database Configuration
DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/garnet_db
# Alternative for SQLite (development)
# DATABASE_URL=sqlite:///data/app.db

# Application Security
SECRET_KEY=your_super_secret_key_here_change_this_in_production
APP_ENV=development

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sistema@garnet.com.br
SMTP_PASSWORD=your_email_password

# External APIs (Optional)
ERP_API_URL=https://api.erp.com/v1
ERP_API_KEY=your_erp_api_key

# Payment Gateway (Optional)
PAYMENT_GATEWAY_URL=https://api.pagseguro.com
PAYMENT_API_KEY=your_payment_api_key

# Shipping APIs (Optional)
CORREIOS_API_KEY=your_correios_api_key
JADLOG_API_KEY=your_jadlog_api_key

# Fiscal Integration (Optional)
SEFAZ_CERTIFICATE_PATH=/path/to/certificate.pfx
SEFAZ_CERTIFICATE_PASSWORD=certificate_password
NFE_API_KEY=your_nfe_api_key

# Performance Settings
CACHE_TTL=300
MAX_RECORDS_PER_PAGE=50
QUERY_TIMEOUT=30

# Security Settings
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=100
SESSION_TIMEOUT_MINUTES=60

# Backup Settings
AUTO_BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=90
ENABLE_AUDIT_LOG=true

# Company Information
COMPANY_NAME=Empresa GARNET Ltda.
COMPANY_CNPJ=12.345.678/0001-99
COMPANY_EMAIL=contato@garnet.com.br
COMPANY_PHONE=(11) 1234-5678

# Internationalization
DEFAULT_LANGUAGE=pt_BR
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_CURRENCY=BRL
